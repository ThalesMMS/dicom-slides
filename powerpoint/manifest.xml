<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:type="ContentApp">
  <Id>3c8d5463-e606-4e35-86de-515114b31089</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>ThalesMMS</ProviderName>
  <DefaultLocale>pt-BR</DefaultLocale>
  <DisplayName DefaultValue="DICOM Slides" />
  <Description DefaultValue="Visualizador interativo de imagens médicas com stack 2D, MPR e renderização 3D dentro de slides do PowerPoint." />
  <IconUrl DefaultValue="https://thalesmms.github.io/dicom-slides/powerpoint/assets/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://thalesmms.github.io/dicom-slides/powerpoint/assets/icon-80.png" />
  <SupportUrl DefaultValue="https://github.com/ThalesMMS/dicom-slides/tree/main/powerpoint" />
  <Hosts>
    <Host Name="Presentation" />
  </Hosts>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://thalesmms.github.io/dicom-slides/powerpoint/content.html" />
    <RequestedWidth>800</RequestedWidth>
    <RequestedHeight>450</RequestedHeight>
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <AllowSnapshot>true</AllowSnapshot>
</OfficeApp>
